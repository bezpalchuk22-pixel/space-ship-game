{
  "name": "space-ship-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@space-ship/client",
    "build": "npm run build --workspace=@space-ship/client",
    "start": "npm run start --workspace=@space-ship/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "bench:load": "tsx server/src/bench/load.ts",
    "bench:websocket": "tsx server/src/bench/websocket-load.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.1.0-beta",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.11.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
